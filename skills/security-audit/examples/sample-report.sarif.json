              "fullDescription": {
                "text": "Slack Bot Token (medium severity)"
              },
              "help": {
                "text": "Pattern: slack-bot-token. Remove the token from source code. Rotate it in the Slack app settings. Use environment variables.",
                "markdown": "**Slack Bot Token**\n\nPattern: slack-bot-token. Remove the token from source code. Rotate it in the Slack app settings. Use environment variables."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "precision": "high",
                "tags": [
                  "security"
                ]
