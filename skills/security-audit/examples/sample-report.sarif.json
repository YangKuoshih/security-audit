          "rules": [
            {
              "id": "aws-access-key/high",
              "shortDescription": {
                "text": "AWS Access Key ID"
              },
              "fullDescription": {
                "text": "AWS Access Key ID (high severity)"
              },
              "help": {
                "text": "Pattern: aws-access-key. Remove the key from source code. Use environment variables or AWS Secrets Manager. Rotate the key immediately via the AWS IAM console.",
                "markdown": "**AWS Access Key ID**\n\nPattern: aws-access-key. Remove the key from source code. Use environment variables or AWS Secrets Manager. Rotate the key immediately via the AWS IAM console."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "precision": "high",
                "tags": [
                  "security"
                ]
              }
            },
            {
              "id": "github-pat-classic/medium",
              "shortDescription": {
                "text": "GitHub PAT (Classic)"
              },
              "fullDescription": {
                "text": "GitHub PAT (Classic) (medium severity)"
              },
              "help": {
                "text": "Pattern: github-pat-classic. Remove the token from source code. Rotate it at github.com/settings/tokens. Use GitHub Actions secrets or environment variables.",
                "markdown": "**GitHub PAT (Classic)**\n\nPattern: github-pat-classic. Remove the token from source code. Rotate it at github.com/settings/tokens. Use GitHub Actions secrets or environment variables."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "precision": "high",
                "tags": [
                  "security"
                ]
              }
            },
            {
              "id": "slack-bot-token/medium",
